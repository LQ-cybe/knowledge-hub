<Window x:Class="__ROOT_NAMESPACE__.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Assets/AppIcon/app.ico"
        Width="880"
        Height="540"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24" Background="{DynamicResource RegionBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="24"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
      <StackPanel>
        <TextBlock FontSize="30"
                   FontWeight="SemiBold"
                   Text="{Binding WindowTitle}" />
        <TextBlock Margin="0,12,0,0"
                   FontSize="15"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding WelcomeMessage}" />
        <TextBlock Margin="0,12,0,0"
                   Foreground="{DynamicResource PrimaryBrush}"
                   Text="默认技术栈：WPF + MVVM + HandyControl" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Padding="20"
              Background="{DynamicResource SecondaryRegionBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="16">
        <StackPanel>
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="默认交付体验" />
          <TextBlock Margin="0,12,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextWrapping="Wrap"
                     Text="这个蓝图默认适合普通用户双击运行，保留了配置文件、日志目录和最小可扩展的 MVVM 结构。" />
          <TextBlock Margin="0,16,0,0"
                     FontWeight="SemiBold"
                     Text="当前状态" />
          <TextBox Margin="0,8,0,0"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   MinHeight="120"
                   Text="{Binding StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2"
              Padding="20"
              Background="{DynamicResource SecondaryRegionBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="16">
        <StackPanel>
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="常用操作" />
          <TextBlock Margin="0,12,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextWrapping="Wrap"
                     Text="先打开日志目录，确认交付时用户可以快速定位运行记录和报错信息。若后续需要贴合企业品牌色，只改 Resources/ThemeOverrides.xaml 即可全局生效。" />
          <Border Margin="0,16,0,0"
                  Padding="12,10"
                  Background="{DynamicResource RegionBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12">
            <StackPanel>
              <TextBlock FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryBrush}"
                         Text="主题覆盖能力" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextWrapping="Wrap"
                         Text="默认保留 HandyControl 官方配色；如用户要求企业主色、警告色或错误色统一替换，优先改 ThemeOverrides.xaml，不要逐页硬编码。" />
            </StackPanel>
          </Border>
          <Button Margin="0,16,0,0"
                  Height="40"
                  Style="{StaticResource ButtonPrimary}"
                  hc:BorderElement.CornerRadius="8"
                  Content="打开日志目录"
                  Command="{Binding OpenLogDirectoryCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="4"
            Padding="14,10"
            Background="{DynamicResource PrimaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
      <TextBlock Foreground="{DynamicResource TextIconBrush}"
                 Text="{Binding HintMessage}" />
    </Border>
  </Grid>
</Window>
