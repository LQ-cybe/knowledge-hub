from __future__ import annotations

import logging
import time
from urllib.parse import urlsplit, urlunsplit

from bs4 import BeautifulSoup
import requests


LOGGER = logging.getLogger(__name__)


def redact_url(url: str) -> str:
    parsed = urlsplit(url)
    host = parsed.hostname or parsed.netloc
    if parsed.port:
        host = f"{host}:{parsed.port}"
    query = "[REDACTED]" if parsed.query else ""
    return urlunsplit((parsed.scheme, host, parsed.path, query, ""))


def fetch_titles(
    url: str,
    *,
    max_attempts: int = 3,
    timeout: float = 10,
    retry_delay_seconds: float = 1,
) -> list[str]:
    safe_url = redact_url(url)

    for attempt in range(1, max_attempts + 1):
        LOGGER.info("开始请求网页：target=%s attempt=%s/%s", safe_url, attempt, max_attempts)
        try:
            response = requests.get(url, timeout=timeout)
            response.raise_for_status()
            LOGGER.info(
                "网页请求成功：target=%s status=%s attempt=%s/%s",
                safe_url,
                response.status_code,
                attempt,
                max_attempts,
            )
            soup = BeautifulSoup(response.text, "html.parser")
            titles = [item.get_text(strip=True) for item in soup.select("h1, h2, h3")]
            result = [title for title in titles if title]
            LOGGER.info("解析标题数量：target=%s count=%s", safe_url, len(result))
            return result
        except requests.RequestException as exc:
            reason = f"{type(exc).__name__}: {exc}"
            if attempt >= max_attempts:
                LOGGER.exception(
                    "网页抓取失败：target=%s attempts=%s/%s reason=%s",
                    safe_url,
                    attempt,
                    max_attempts,
                    reason,
                )
                raise

            LOGGER.warning(
                "网页抓取失败，准备重试：target=%s attempt=%s/%s reason=%s delay_seconds=%s",
                safe_url,
                attempt,
                max_attempts,
                reason,
                retry_delay_seconds,
            )
            time.sleep(retry_delay_seconds)
        except Exception as exc:
            reason = f"{type(exc).__name__}: {exc}"
            LOGGER.exception("网页抓取出现非预期异常：target=%s reason=%s", safe_url, reason)
            raise

    raise RuntimeError("网页抓取未返回结果。")
