from __future__ import annotations

import logging
from pathlib import Path

from __PACKAGE_NAME__.logging_setup import configure_logging
from __PACKAGE_NAME__.scraper import fetch_titles, redact_url


LOGGER = logging.getLogger(__name__)


def main() -> None:
    log_file = configure_logging()
    target_url = "https://example.com"
    LOGGER.info("网页抓取开始：target=%s log=%s", redact_url(target_url), log_file)
    titles = fetch_titles(target_url)
    output_file = Path("output") / "titles.txt"
    output_file.parent.mkdir(exist_ok=True)
    output_file.write_text("\n".join(titles), encoding="utf-8")
    LOGGER.info("网页抓取完成，输出文件：%s", output_file.resolve())
    print(f"抓取完成：{output_file.resolve()}\n日志目录：{log_file.parent}")


if __name__ == "__main__":
    main()
