from __future__ import annotations

import logging
from pathlib import Path

from __PACKAGE_NAME__.logging_setup import configure_logging
from __PACKAGE_NAME__.processor import process_directory


LOGGER = logging.getLogger(__name__)


def main() -> None:
    log_file = configure_logging()
    input_dir = Path("input")
    output_dir = Path("output")
    output_dir.mkdir(exist_ok=True)
    LOGGER.info("批处理开始：input=%s output=%s log=%s", input_dir.resolve(), output_dir.resolve(), log_file)
    process_directory(input_dir=input_dir, output_dir=output_dir)
    LOGGER.info("批处理完成：%s", output_dir.resolve())
    print(f"处理完成，结果目录：{output_dir.resolve()}\n日志目录：{log_file.parent}")


if __name__ == "__main__":
    main()
